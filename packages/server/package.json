    "@gltf-transform/functions": "^4.2.1",
    "fast-glob": "^3.3.2",
    "fastify": "^4.26.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5"
  }
}
